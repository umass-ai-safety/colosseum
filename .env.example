# DO NOT PUT SECRETS IN THIS FILE.
# Copy this template to `.env` and fill in your keys with:
#
#   cp -n .env.example .env
#
# `.env` is gitignored.

# Provider API keys: uncomment the ones you use.
# Terrarium loads `.env` with override=True, so an uncommented empty line
# (e.g. `OPENAI_API_KEY=`) blanks out a key exported in your shell.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=

# The DCOP environments need a CoLLAB checkout. Running from the repo root finds
# the `external/CoLLAB` submodule automatically. For a checkout elsewhere, export
# TERRARIUM_COLLAB_PATH=/path/to/CoLLAB in your shell: it is read when the
# environments are imported, before this file is loaded, so setting it here has no effect.
